# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Jupyter
.ipynb_checkpoints/

# Data (too large / not meant for git — track via README instead)
data/raw/*
data/processed/*
data/synthetic/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep

# Model weights (large files — consider Git LFS if you must commit them)
models/weights/*.pt
models/weights/*.onnx
!models/weights/.gitkeep

# Ultralytics training runs
runs/

# Reports (sample outputs are fine to commit selectively, ignore bulk runs)
reports/*.json
reports/*.csv
!reports/sample_report.json
!reports/sample_report.csv

# OS / editor
.DS_Store
.vscode/
*.swp

# Legacy local secrets (the app now uses .env.local)
.streamlit/secrets.toml
