# Local dashboard API uses demo CSV results by default. Set DEMO_MODE=false
# and configure INFERENCE_API_URL to use the live inference tunnel.
DEMO_MODE=true
INFERENCE_API_URL=
# Set GEMINI_API_KEY only in the local inference API process, never in the browser.
# The inference API defaults to gemini-3.8-flash; override with GEMINI_MODEL if needed.

# Optional CARTO basemap key: https://carto.com/basemaps/apikey/
NEXT_PUBLIC_CARTO_API_KEY=your_carto_basemap_api_key
